PORT=5001

# MongoDB (DB2)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=quiz_db

# Must be the same value as INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=CHANGE_ME

# How long the quiz processing lasts (seconds), to simulate a slow processing
PROCESSING_DELAY_SECONDS=10

# Email for sending quiz results
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Address the mail is sent from
EMAIL_USER=
# Google "App password", not the real account password
EMAIL_PASS=
# e.g. Quiz Platform <same address as EMAIL_USER>
EMAIL_FROM=
