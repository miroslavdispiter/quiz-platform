# ---------------------------------------------------------------
# Quiz Service (internal service, called only by the main server)
# ---------------------------------------------------------------
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=1
LOG_LEVEL=INFO

# --- MongoDB (DB2) ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=quiz_db
MONGO_TIMEOUT_MS=3000

# --- Communication with the main server ---
MAIN_SERVER_URL=http://localhost:5000
# Must be the same value as INTERNAL_API_KEY in server/.env (required, no default)
INTERNAL_API_KEY=CHANGE_ME
REQUEST_TIMEOUT_SECONDS=5

# --- Asynchronous quiz grading (processes) ---
GRADING_WORKERS=2
# Artificial delay that simulates long grading
GRADING_DELAY_SECONDS=10

# --- Email (results are sent from the grading worker) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Address the mail is sent from
EMAIL_USER=
# Google "App password", not the real account password
EMAIL_PASS=
# e.g. Quiz Platform <same address as EMAIL_USER>
EMAIL_FROM=
