MONGO_URI=mongodb://localhost:27017/
DB_NAME=quiz_db
MAIN_SERVER_URL=http://localhost:5000
# Must be same as INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=CHANGE_ME

# Redis is optional; empty = no bags. 
# Leave it blank until you install it; when you start it, type: REDIS_HOST=localhost
REDIS_HOST=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=#FROM WHICH MAIL IS SENT
EMAIL_PASS=#apppasswords on google
EMAIL_FROM=#QUIZ PLATFORM <same mail as EMAIL_USER>
