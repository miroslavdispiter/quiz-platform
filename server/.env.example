# ---------------------------------------------------------------
# Main server (API gateway + DB1)
# ---------------------------------------------------------------

# --- MySQL (DB1) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=drs_db
DB_USER=drs_user
DB_PASSWORD=CHANGE_ME

# --- Security ---
JWT_SECRET_KEY=CHANGE_ME
# Must be the same value as INTERNAL_API_KEY in quiz_service/.env
INTERNAL_API_KEY=CHANGE_ME

# --- Quiz Service ---
QUIZ_SERVICE_URL=http://localhost:5001
REQUEST_TIMEOUT_SECONDS=5

# --- Frontend origin (CORS + Socket.IO) ---
CLIENT_ORIGIN=http://localhost:5173

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Address the mail is sent from
EMAIL_USER=
# Google "App password", not the real account password
EMAIL_PASS=
# e.g. Quiz Platform <same address as EMAIL_USER>
EMAIL_FROM=
